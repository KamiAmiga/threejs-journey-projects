<script>
  import * as THREE from 'three'
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js'
  import GUI from 'lil-gui'

  // THREE Settings
  THREE.ColorManagement.enabled = false

  // Canvas
  const canvas = document.querySelector('[data-threejs-canvas]')

  // Debug UI
  const gui = new GUI({
    container: document.querySelector(
      '.project-page__canvas-wrapper',
    ) as HTMLDivElement,
  })

  // TextureLoader
  const loadingManager = new THREE.LoadingManager()
  const textureLoader = new THREE.TextureLoader(loadingManager)

  // Sizes
  const sizes = {
    width: window.innerWidth,
    height: window.innerHeight,
  }

  // Scene
  const scene = new THREE.Scene()
  scene.background = new THREE.Color(0x151515)

  // Geometries
  const coneGeometry = new THREE.ConeGeometry(0.5, 1, 16)
  const sphereGeometry = new THREE.SphereGeometry(0.5, 64, 64)
  const torusKnotGeometry = new THREE.TorusKnotGeometry(0.33, 0.1)

  // Textures
  const toon3ShadesBaseTexture = textureLoader.load(
    '/threejs-journey-projects/textures/toon-material/toon-3shades-base-texture.jpg',
  )
  const toon3ShadesDarkerTexture = textureLoader.load(
    '/threejs-journey-projects/textures/toon-material/toon-3shades-darker-texture.jpg',
  )
  const toon5ShadesBaseTexture = textureLoader.load(
    '/threejs-journey-projects/textures/toon-material/toon-5shades-base-texture.jpg',
  )

  const textures = [
    toon3ShadesBaseTexture,
    toon3ShadesDarkerTexture,
    toon5ShadesBaseTexture,
  ]

  textures.forEach((texture) => {
    texture.generateMipmaps = false
    texture.minFilter = THREE.NearestFilter
    texture.magFilter = THREE.NearestFilter
  })

  // Materials
  const coneMaterial = new THREE.MeshToonMaterial({
    color: 0x67e22c,
    gradientMap: toon3ShadesBaseTexture,
  })
  const sphereMaterial = new THREE.MeshToonMaterial({
    color: 0x6426d7,
    gradientMap: toon3ShadesBaseTexture,
  })
  const torusKnotMaterial = new THREE.MeshToonMaterial({
    color: 0xfe720a,
    gradientMap: toon3ShadesBaseTexture,
  })

  // Assembling objects in the scene
  const coneMesh = new THREE.Mesh(coneGeometry, coneMaterial)
  const sphereMesh = new THREE.Mesh(sphereGeometry, sphereMaterial)
  const torusKnotMesh = new THREE.Mesh(torusKnotGeometry, torusKnotMaterial)

  sphereMesh.position.x = -1.5
  torusKnotMesh.position.x = 1.5

  scene.add(coneMesh, sphereMesh, torusKnotMesh)

  // Lights
  const ambientLight = new THREE.AmbientLight(0xffffff, 1)
  const pointLight = new THREE.PointLight(0xffffff, 30)
  pointLight.position.set(2, 3, 4)

  scene.add(ambientLight, pointLight)

  // Camera
  const camera = new THREE.PerspectiveCamera(75, sizes.width / sizes.height)
  camera.position.set(0, 1, 3)
  scene.add(camera)

  // Renderer
  const renderer = canvas
    ? new THREE.WebGLRenderer({ canvas })
    : new THREE.WebGLRenderer()
  renderer.setSize(sizes.width, sizes.height)
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))

  if (!canvas) {
    document.body.appendChild(renderer.domElement)
  }

  // Debug UI Params
  const sphereMaterialFolder = gui.addFolder('Sphere material')
  sphereMaterialFolder.addColor(sphereMaterial, 'color')
  sphereMaterialFolder.add(sphereMaterial, 'gradientMap', {
    threeShadesBase: toon3ShadesBaseTexture,
    threeShadesDarker: toon3ShadesDarkerTexture,
    fiveShades: toon5ShadesBaseTexture,
  })

  const coneMaterialFolder = gui.addFolder('Cone material')
  coneMaterialFolder.addColor(coneMaterial, 'color')
  coneMaterialFolder.add(coneMaterial, 'gradientMap', {
    threeShadesBase: toon3ShadesBaseTexture,
    threeShadesDarker: toon3ShadesDarkerTexture,
    fiveShades: toon5ShadesBaseTexture,
  })

  const torusKnotMaterialFolder = gui.addFolder('Torus knot material')
  torusKnotMaterialFolder.addColor(torusKnotMaterial, 'color')
  torusKnotMaterialFolder.add(torusKnotMaterial, 'gradientMap', {
    threeShadesBase: toon3ShadesBaseTexture,
    threeShadesDarker: toon3ShadesDarkerTexture,
    fiveShades: toon5ShadesBaseTexture,
  })

  const ambientLightFolder = gui.addFolder('Ambient light')
  ambientLightFolder.addColor(ambientLight, 'color')
  ambientLightFolder.add(ambientLight, 'intensity').min(0).max(10).step(0.1)

  const pointLightFolder = gui.addFolder('Point light')
  pointLightFolder.addColor(pointLight, 'color')
  pointLightFolder.add(ambientLight, 'intensity').min(0).max(10).step(0.1)
  pointLightFolder
    .add(pointLight.position, 'x')
    .min(-5)
    .max(5)
    .step(0.1)
    .name('X Pos')
  pointLightFolder
    .add(pointLight.position, 'y')
    .min(-5)
    .max(5)
    .step(0.1)
    .name('Y Pos')
  pointLightFolder
    .add(pointLight.position, 'z')
    .min(-5)
    .max(5)
    .step(0.1)
    .name('Z Pos')

  // Controls
  const controls = new OrbitControls(camera, renderer.domElement)
  controls.enableDamping = true
  controls.minDistance = 3
  controls.update()

  window.addEventListener('resize', () => {
    // Update sizes
    sizes.width = window.innerWidth
    sizes.height = window.innerHeight

    // Update camera
    camera.aspect = sizes.width / sizes.height
    camera.updateProjectionMatrix()

    // Update renderer
    renderer.setSize(sizes.width, sizes.height)
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))
  })

  /**
   * Animate
   */
  const timer = new THREE.Timer()
  timer.connect(document)

  const tick = () => {
    timer.update()
    const timeDelta = timer.getElapsed()

    coneMesh.rotation.y = 0.1 * timeDelta
    sphereMesh.rotation.y = 0.1 * timeDelta
    torusKnotMesh.rotation.y = 0.1 * timeDelta

    coneMesh.rotation.x = 0.15 * timeDelta
    sphereMesh.rotation.x = 0.15 * timeDelta
    torusKnotMesh.rotation.x = 0.15 * timeDelta

    // Update controls
    controls.update()

    // Render
    renderer.render(scene, camera)

    // Call tick again on the next frame
    window.requestAnimationFrame(tick)
  }

  tick()
</script>
