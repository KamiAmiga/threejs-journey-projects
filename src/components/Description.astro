---
const { class: className, title, id, ...rest } = Astro.props
---

<div id={id} class:list={['description', className]} {...rest}>
  <h1 class="description__title">{title}</h1>

  <div class="description__text">
    <slot />
  </div>
</div>

<style>
  .description {
    max-width: 85ch;
  }

  .description__title {
    padding-block: 1rem;
    font-size: 2.5rem;
    line-height: 4rem;
  }

  .description__text {
    padding-block-start: 0.5rem;
    font-size: 1.125rem;
    line-height: 2rem;
  }

  .description__text p + p {
    margin-block-start: 2rem;
  }
</style>
