---
import { Font } from 'astro:assets'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/threejs-journey-projects/favicon.svg"
    />
    <link rel="icon" href="/threejs-journey-projects/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>My journey with ThreeJS Journey</title>
    <Font cssVariable="--font-primary" />
  </head>

  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* Global custom styles */
  :root {
    --color-primary-shade-1: #b06e53;
    --color-primary-shade-2: #8c5742;
    --color-primary-shade-3: #633e2f;
    --color-primary-shade-4: #3b241c;
    --color-primary-shade-5: #de8a68;
    --color-secondary-shade-1: #faf9f5;
    --color-accent-shade-1: #212154;
  }

  body {
    font-family: var(--font-primary), sans-serif;
    /* wood effect ref : https://codepen.io/robleto/pen/YPKNGjv */
    background-color: var(--color-primary-shade-1);
    background-image:
      linear-gradient(
        to bottom,
        rgb(from var(--color-primary-shade-4) r g b / 0.1) 95%,
        rgb(from var(--color-primary-shade-4) r g b / 0.5) 98%,
        transparent
      ),
      linear-gradient(
        to bottom,
        transparent 2%,
        rgb(from var(--color-primary-shade-5) r g b / 0.1) 2%,
        rgb(from var(--color-primary-shade-5) r g b / 0.4) 4%,
        transparent 4.5%,

        transparent 12%,
        rgb(from var(--color-primary-shade-2) r g b / 0.1) 12%,
        rgb(from var(--color-primary-shade-2) r g b / 0.3) 13.5%,
        transparent 13.5%,

        transparent 15%,
        rgb(from var(--color-primary-shade-5) r g b / 0.25) 15%,
        rgb(from var(--color-primary-shade-5) r g b / 0.5) 16%,
        transparent 16%,

        transparent 28%,
        rgb(from var(--color-primary-shade-2) r g b / 0.2) 30.5%,
        transparent 31%,

        transparent 35%,
        rgb(from var(--color-primary-shade-5) r g b / 0.1) 35%,
        rgb(from var(--color-primary-shade-5) r g b / 0.25) 39%,
        transparent 40%,

        transparent 42%,
        rgb(from var(--color-primary-shade-5) r g b / 0.1) 42.5%,
        rgb(from var(--color-primary-shade-5) r g b / 0.4) 44%,
        transparent 44%,

        transparent 52%,
        rgb(from var(--color-primary-shade-2) r g b / 0.1) 52%,
        rgb(from var(--color-primary-shade-2) r g b / 0.3) 53.5%,
        transparent 53.5%,

        transparent 55%,
        rgb(from var(--color-primary-shade-2) r g b / 0.25) 55.5%,
        transparent 56%,

        transparent 65%,
        rgb(from var(--color-primary-shade-5) r g b / 0.2) 66%,
        rgb(from var(--color-primary-shade-5) r g b / 0.25) 68%,
        transparent 68.5%,

        transparent 70%,
        rgb(from var(--color-primary-shade-5) r g b / 0.5) 70.5%,
        transparent 71%,

        transparent 82%,
        rgb(from var(--color-primary-shade-5) r g b / 0.1) 82.5%,
        rgb(from var(--color-primary-shade-5) r g b / 0.33) 84%,
        transparent 84%,

        transparent 93%,
        rgb(from var(--color-primary-shade-2) r g b / 0.2) 93.5%,
        rgb(from var(--color-primary-shade-2) r g b / 0.4) 94.5%,
        transparent 95%
      );
    background-size:
      100% 10rem,
      100% 20rem;
    background-repeat: repeat-y;
  }

  /* Utils */

  .sr-only {
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    position: absolute;
    overflow: hidden;
  }

  .squared-paper {
    --pattern-size: 10rem; /* control the size*/
    --bg-line-clr: #cadcf2;
    --paper-line-clr: var(--color-secondary-shade-1);
    --_pattern-gradient: #0000 90deg, var(--bg-line-clr) 0;

    background:
      conic-gradient(from 90deg at 2px 2px, var(--_pattern-gradient)),
      conic-gradient(from 90deg at 1px 1px, var(--_pattern-gradient)),
      var(--paper-line-clr);
    background-size:
      var(--pattern-size) var(--pattern-size),
      calc(var(--pattern-size) / 5) calc(var(--pattern-size) / 5);
    color: var(--color-accent-shade-1);

    & :is(h1, h2, h3, h4, p, figure, blockquote, dl, dd):not(:first-child) {
      margin-block-start: 2rem;
    }
  }

  /* Reset */

  /* Box sizing rules */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* Prevent font size inflation */
  html {
    -moz-text-size-adjust: none;
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
  }

  /* Remove default margin in favour of better control in authored CSS */
  h1,
  h2,
  h3,
  h4,
  p,
  figure,
  blockquote,
  dl,
  dd {
    margin-block-end: 0;
  }

  h1:first-child,
  h2:first-child,
  h3:first-child,
  h4:first-child,
  p:first-child,
  figure:first-child,
  blockquote:first-child,
  dl:first-child,
  dd:first-child {
    margin-block-start: 0;
  }

  /* Remove list styles on ul, ol elements with a list role, which suggests default styling will be removed */
  ul[role='list'],
  ol[role='list'] {
    list-style: none;
  }

  /* Set core body defaults */
  body {
    min-height: 100vh;
    padding: 0;
    margin: 0;
    text-rendering: optimizeSpeed;
  }

  /* A elements that don't have a class get default styles */
  a:not([class]) {
    text-decoration-skip-ink: auto;
    color: currentColor;
  }

  /* Make images easier to work with */
  img,
  picture {
    max-width: 100%;
    display: block;
  }

  /* Inherit fonts for inputs and buttons */
  input,
  button,
  textarea,
  select {
    font-family: inherit;
    font-size: inherit;
  }

  /* Make sure textareas without a rows attribute are not tiny */
  textarea:not([rows]) {
    min-height: 10em;
  }

  /* Anything that has been anchored to should have extra scroll margin */
  :target {
    scroll-margin-block: 5ex;
  }
</style>
